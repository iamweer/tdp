<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="project_project_view_form_custom_extension" model="ir.ui.view">
        <field name="name">project.project.form.custom.extension</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <field name="date" position="after">
                <field name="warranty_start_date"/>
                <field name="warranty_end_date"/>
                <field name="company_type"/>
            </field>
            <page name="description" position="after">
                <page name="weighted_progress" string="Avance">
                    <group>
                        <group>
                            <field name="weighted_progress" widget="progressbar"/>
                        </group>
                        <group>
                            <field name="progress_weight_total"
                                   decoration-success="progress_weight_total == 100"
                                   decoration-warning="progress_weight_total != 100"/>
                        </group>
                    </group>
                    <div class="text-muted mb-2">
                        Asigne a cada tarea principal su peso en el proyecto (la suma no puede superar 100%).
                        El peso se reparte en partes iguales entre sus subtareas no canceladas y el avance
                        solo considera las tareas completadas. Los totales se actualizan al guardar.
                    </div>
                    <field name="main_task_ids"
                           context="{'default_project_id': id}">
                        <list editable="bottom" create="0" delete="0" default_order="sequence, name, id">
                            <field name="sequence" widget="handle"/>
                            <field name="name" readonly="1"/>
                            <field name="user_ids" widget="many2many_avatar_user" readonly="1" optional="show"/>
                            <field name="stage_id" readonly="1" optional="show"/>
                            <field name="state" widget="project_task_state_selection" readonly="1" optional="show"/>
                            <field name="subtask_count" string="Subtareas" readonly="1" optional="show"/>
                            <field name="project_weight" sum="Total"/>
                            <field name="project_progress_percentage" widget="progressbar"/>
                        </list>
                    </field>
                </page>
            </page>
        </field>
    </record>

    <record id="project_project_view_list_custom_extension" model="ir.ui.view">
        <field name="name">project.project.list.custom.extension</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="company_type" optional="show"/>
            </field>
        </field>
    </record>

    <record id="project_project_view_search_custom_extension" model="ir.ui.view">
        <field name="name">project.project.search.custom.extension</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project_project_filter"/>
        <field name="arch" type="xml">
            <filter name="inactive" position="before">
                <filter string="Empresa TDP" name="company_type_tdp" domain="[('company_type', '=', 'tdp')]"/>
                <filter string="Empresa ABI" name="company_type_abi" domain="[('company_type', '=', 'abi')]"/>
                <separator/>
            </filter>
            <filter name="Manager" position="after">
                <filter string="Empresa" name="groupby_company_type" context="{'group_by': 'company_type'}"/>
            </filter>
        </field>
    </record>

    <record id="project_project_view_kanban_custom_extension" model="ir.ui.view">
        <field name="name">project.project.kanban.custom.extension</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@t-if='record.date.raw_value or record.date_start.raw_value']" position="after">
                <div t-if="record.warranty_period_display.raw_value" class="text-muted">
                    <span class="fa fa-shield me-2" title="Garantía"/>
                    <field name="warranty_period_display"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
