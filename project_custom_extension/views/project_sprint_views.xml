<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="project_sprint_view_list" model="ir.ui.view">
        <field name="name">project.sprint.list</field>
        <field name="model">project.sprint</field>
        <field name="arch" type="xml">
            <list string="Sprints" default_order="project_id, sequence, name">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="project_id"/>
                <field name="task_count"/>
            </list>
        </field>
    </record>

    <record id="project_sprint_view_form" model="ir.ui.view">
        <field name="name">project.sprint.form</field>
        <field name="model">project.sprint</field>
        <field name="arch" type="xml">
            <form string="Sprint">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="project_id" options="{'no_create': True}"/>
                        <field name="sequence"/>
                        <field name="task_count" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="project_sprint_action" model="ir.actions.act_window">
        <field name="name">Sprints</field>
        <field name="res_model">project.sprint</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
        <field name="domain">[]</field>
    </record>

    <menuitem id="project_sprint_menu"
              name="Sprints"
              parent="project.menu_main_pm"
              action="project_sprint_action"
              sequence="38"
              groups="project.group_project_user,project.group_project_manager"/>
</odoo>
