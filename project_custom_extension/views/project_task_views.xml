<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="project_task_view_form_custom_extension" model="ir.ui.view">
        <field name="name">project.task.form.custom.extension</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//label[@for='date_deadline']" position="attributes">
                <attribute name="for">planned_date_begin</attribute>
                <attribute name="string">Fecha límite</attribute>
            </xpath>
            <xpath expr="//div[@id='date_deadline_and_recurring_task']/field[@name='date_deadline']" position="replace">
                <field name="planned_date_begin"
                       nolabel="1"
                       widget="daterange"
                       options="{'end_date_field': 'date_deadline', 'always_range': True}"
                       decoration-danger="date_deadline and date_deadline &lt; current_date and state not in ['1_done', '1_canceled']"/>
                <field name="date_deadline" invisible="1"/>
            </xpath>
            <xpath expr="//div[@id='date_deadline_and_recurring_task']" position="after">
                <field name="sprint_id" options="{'no_create': True}"/>
                <field name="hierarchical_priority" string="Prioridad jerárquica"/>
            </xpath>
        </field>
    </record>

    <record id="project_task_view_list_custom_extension" model="ir.ui.view">
        <field name="name">project.task.list.custom.extension</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.project_task_view_tree_main_base"/>
        <field name="arch" type="xml">
            <field name="date_deadline" position="before">
                <field name="planned_date_begin" optional="hide"/>
                <field name="hierarchical_priority" string="Prioridad jerárquica" optional="show"/>
                <field name="sprint_id" optional="show"/>
            </field>
            <xpath expr="//list" position="attributes">
                <attribute name="default_order">sprint_sequence_order, hierarchical_priority_order, priority desc, sequence, state, date_deadline asc, id desc</attribute>
            </xpath>
            <xpath expr="//list/field[@name='sequence']" position="after">
                <field name="sprint_sequence_order" column_invisible="True"/>
                <field name="hierarchical_priority_order" column_invisible="True"/>
            </xpath>
        </field>
    </record>

    <record id="project_task_view_kanban_custom_extension" model="ir.ui.view">
        <field name="name">project.task.kanban.custom.extension</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//kanban" position="attributes">
                <attribute name="default_order">sprint_sequence_order, hierarchical_priority_order, priority desc, sequence, state, date_deadline asc, id desc</attribute>
            </xpath>
            <xpath expr="//kanban/field[@name='stage_id']" position="after">
                <field name="sprint_sequence_order"/>
                <field name="hierarchical_priority_order"/>
            </xpath>
            <xpath expr="//templates/t[@t-name='card']/main/field[@name='name']" position="after">
                <div class="text-muted small">
                    <span>Prioridad jerárquica: </span>
                    <field name="hierarchical_priority"/>
                </div>
                <div t-if="record.sprint_id.raw_value" class="text-muted small">
                    <span>Sprint: </span>
                    <field name="sprint_id"/>
                </div>
            </xpath>
        </field>
    </record>

    <record id="project.action_view_all_task" model="ir.actions.act_window">
        <field name="domain">[]</field>
    </record>
</odoo>
