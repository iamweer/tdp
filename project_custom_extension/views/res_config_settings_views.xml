<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_project_dashboard" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.project.dashboard</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="project.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='project']" position="inside">
                <block title="Dashboard de proyectos" id="project_dashboard_settings">
                    <setting id="project_dashboard_health_weights"
                             string="Pesos de la salud general"
                             help="Define la participación del avance, el estado y la operación. Los tres valores deben sumar 100.">
                        <div class="content-group">
                            <div class="row mt16">
                                <label for="project_dashboard_progress_weight" class="col-lg-5 o_light_label"/>
                                <div class="col-lg-7">
                                    <field name="project_dashboard_progress_weight" class="oe_inline"/>
                                    <span class="ms-1">%</span>
                                </div>
                            </div>
                            <div class="row mt8">
                                <label for="project_dashboard_status_weight" class="col-lg-5 o_light_label"/>
                                <div class="col-lg-7">
                                    <field name="project_dashboard_status_weight" class="oe_inline"/>
                                    <span class="ms-1">%</span>
                                </div>
                            </div>
                            <div class="row mt8">
                                <label for="project_dashboard_operations_weight" class="col-lg-5 o_light_label"/>
                                <div class="col-lg-7">
                                    <field name="project_dashboard_operations_weight" class="oe_inline"/>
                                    <span class="ms-1">%</span>
                                </div>
                            </div>
                        </div>
                    </setting>
                    <setting id="project_dashboard_health_thresholds"
                             string="Umbrales de salud"
                             help="Los resultados por debajo del umbral de atención se consideran críticos.">
                        <div class="content-group">
                            <div class="row mt16">
                                <label for="project_dashboard_healthy_threshold" class="col-lg-5 o_light_label"/>
                                <div class="col-lg-7">
                                    <field name="project_dashboard_healthy_threshold" class="oe_inline"/>
                                    <span class="ms-1">%</span>
                                </div>
                            </div>
                            <div class="row mt8">
                                <label for="project_dashboard_attention_threshold" class="col-lg-5 o_light_label"/>
                                <div class="col-lg-7">
                                    <field name="project_dashboard_attention_threshold" class="oe_inline"/>
                                    <span class="ms-1">%</span>
                                </div>
                            </div>
                        </div>
                    </setting>
                    <setting id="project_schedule_risk_deviation"
                             string="Semáforo del cronograma"
                             help="Puntos por debajo del avance esperado (días transcurridos ÷ duración del proyecto) a partir de los cuales un proyecto sin vencimientos pasa a En riesgo de atraso.">
                        <div class="content-group">
                            <div class="row mt16">
                                <label for="project_schedule_risk_deviation" class="col-lg-5 o_light_label"/>
                                <div class="col-lg-7">
                                    <field name="project_schedule_risk_deviation" class="oe_inline"/>
                                    <span class="ms-1">pts</span>
                                </div>
                            </div>
                        </div>
                    </setting>
                </block>
                <block title="Registro de horas" id="project_time_entry_settings">
                    <setting id="project_time_alert_reminder"
                             help="Viernes 3 p. m.: correo a cada persona con los días de la semana (hasta el jueves) en que no registró horas.">
                        <field name="project_time_alert_reminder"/>
                    </setting>
                    <setting id="project_time_alert_summary"
                             help="Lunes 8 a. m.: correo a los gerentes con todo el equipo y a cada PM con las personas de sus proyectos que no registraron horas la semana anterior.">
                        <field name="project_time_alert_summary"/>
                    </setting>
                    <setting id="project_time_holidays"
                             string="Festivos"
                             help="Los festivos de Colombia se cargan cada año como ausencias globales del horario laboral (pestaña Ausencias). En el registro de horas cuentan como horas cumplidas.">
                        <div class="mt8">
                            <button name="%(resource.action_resource_calendar_form)d"
                                    type="action"
                                    string="Horarios laborales y festivos"
                                    class="btn-link"
                                    icon="oi-arrow-right"/>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
