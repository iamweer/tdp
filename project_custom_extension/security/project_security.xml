<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_project_client" model="res.groups">
        <field name="name">Clientes</field>
        <field name="category_id" ref="base.module_category_services_project"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Global rules prevent generic internal users from reaching project data. -->
    <record id="project_role_gate_rule" model="ir.rule">
        <field name="name">Proyectos: acceso interno por rol</field>
        <field name="model_id" ref="project.model_project_project"/>
        <field name="domain_force">[(1, '=', 1)] if user.has_group('project.group_project_manager') or user.has_group('project.group_project_user') or user.has_group('project_custom_extension.group_project_client') or user.has_group('base.group_portal') else [('id', '=', 0)]</field>
    </record>
    <record id="task_role_gate_rule" model="ir.rule">
        <field name="name">Tareas: acceso interno por rol</field>
        <field name="model_id" ref="project.model_project_task"/>
        <field name="domain_force">[(1, '=', 1)] if user.has_group('project.group_project_manager') or user.has_group('base.group_portal') else [('project_id', '!=', False)] if user.has_group('project_custom_extension.group_project_client') else [(1, '=', 1)] if user.has_group('project.group_project_user') else [('id', '=', 0)]</field>
    </record>

    <record id="project_user_visibility_rule" model="ir.rule">
        <field name="name">Proyectos: Usuario ve proyectos propios o asignados</field>
        <field name="model_id" ref="project.model_project_project"/>
        <field name="domain_force">[('active', '=', True), '|', ('create_uid', '=', user.id), ('tasks', 'any', [('active', '=', True), ('user_ids', 'in', user.id)])] if not user.has_group('project_custom_extension.group_project_client') else [('id', '=', 0)]</field>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
        <field name="groups" eval="[(4, ref('project.group_project_user'))]"/>
    </record>
    <record id="project_user_edit_own_rule" model="ir.rule">
        <field name="name">Proyectos: Usuario modifica solo los propios</field>
        <field name="model_id" ref="project.model_project_project"/>
        <field name="domain_force">[('active', '=', True), ('create_uid', '=', user.id)] if not user.has_group('project_custom_extension.group_project_client') else [('id', '=', 0)]</field>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
        <field name="groups" eval="[(4, ref('project.group_project_user'))]"/>
    </record>
    <record id="project_client_visibility_rule" model="ir.rule">
        <field name="name">Proyectos: Cliente ve proyectos asignados o relacionados</field>
        <field name="model_id" ref="project.model_project_project"/>
        <field name="domain_force">[('active', '=', True), '|', ('partner_id.commercial_partner_id', '=', user.partner_id.commercial_partner_id.id), ('tasks', 'any', [('active', '=', True), ('user_ids', 'in', user.id)])]</field>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
        <field name="groups" eval="[(4, ref('project_custom_extension.group_project_client'))]"/>
    </record>

    <record id="task_user_visibility_rule" model="ir.rule">
        <field name="name">Tareas: Usuario ve tareas de proyectos accesibles</field>
        <field name="model_id" ref="project.model_project_task"/>
        <field name="domain_force">[('active', '=', True), '|', '&amp;', ('project_id', '!=', False), '&amp;', ('project_id.active', '=', True), '|', ('project_id.create_uid', '=', user.id), ('project_id.tasks', 'any', [('active', '=', True), ('user_ids', 'in', user.id)]), '&amp;', ('project_id', '=', False), ('user_ids', 'in', user.id)] if not user.has_group('project_custom_extension.group_project_client') else [('id', '=', 0)]</field>
        <field name="groups" eval="[(4, ref('project.group_project_user'))]"/>
    </record>
    <record id="task_user_manage_visible_rule" model="ir.rule">
        <field name="name">Tareas: Usuario opera tareas de proyectos accesibles</field>
        <field name="model_id" ref="project.model_project_task"/>
        <field name="domain_force">[('active', '=', True), '|', '&amp;', ('project_id', '!=', False), '&amp;', ('project_id.active', '=', True), '|', ('project_id.create_uid', '=', user.id), ('project_id.tasks', 'any', [('active', '=', True), ('user_ids', 'in', user.id)]), '&amp;', ('project_id', '=', False), ('user_ids', 'in', user.id)] if not user.has_group('project_custom_extension.group_project_client') else [('id', '=', 0)]</field>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
        <field name="groups" eval="[(4, ref('project.group_project_user'))]"/>
    </record>
    <record id="task_client_visibility_rule" model="ir.rule">
        <field name="name">Tareas: Cliente ve tareas de proyectos accesibles</field>
        <field name="model_id" ref="project.model_project_task"/>
        <field name="domain_force">[('active', '=', True), ('project_id.active', '=', True), '|', ('project_id.partner_id.commercial_partner_id', '=', user.partner_id.commercial_partner_id.id), ('project_id.tasks', 'any', [('active', '=', True), ('user_ids', 'in', user.id)])]</field>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
        <field name="groups" eval="[(4, ref('project_custom_extension.group_project_client'))]"/>
    </record>
    <record id="task_client_assigned_write_rule" model="ir.rule">
        <field name="name">Tareas: Cliente modifica solo sus tareas activas</field>
        <field name="model_id" ref="project.model_project_task"/>
        <field name="domain_force">[('active', '=', True), ('project_id.active', '=', True), ('user_ids', 'in', user.id)]</field>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
        <field name="groups" eval="[(4, ref('project_custom_extension.group_project_client'))]"/>
    </record>

    <record id="project.menu_main_pm" model="ir.ui.menu">
        <field name="groups_id" eval="[(4, ref('project_custom_extension.group_project_client'))]"/>
    </record>
    <record id="project.menu_project_report_task_analysis" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [ref('project.group_project_user')])]"/>
    </record>
</odoo>
