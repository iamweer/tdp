<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="project_custom_extension.ProjectDetailDashboard">
        <div class="o_project_detail_dashboard">
            <div class="o_project_detail_dashboard_container">
                <header class="o_project_detail_dashboard_header">
                    <div class="o_project_detail_dashboard_heading">
                        <h1>Seguimiento ejecutivo de proyectos</h1>
                        <p t-if="project">
                            <t t-out="project.name"/> · <t t-out="project.customer_name"/>
                        </p>
                        <p t-else="">Visión clara para tomar mejores decisiones</p>
                    </div>
                    <div t-if="project" class="o_project_detail_dashboard_header_actions">
                        <button type="button" class="btn btn-light" t-on-click="openProjectTasks">
                            <i class="fa fa-external-link me-1" aria-hidden="true"/>Abrir proyecto
                        </button>
                        <button type="button" class="btn btn-light" t-on-click="openProjectGantt">
                            <i class="fa fa-calendar me-1" aria-hidden="true"/>Cronograma
                        </button>
                    </div>
                </header>

                <section class="o_project_detail_dashboard_card o_project_detail_dashboard_filters" aria-label="Filtros">
                    <div class="o_project_detail_dashboard_filter">
                        <label for="project_detail_customer">Cliente</label>
                        <Many2XAutocomplete
                            id="'project_detail_customer'"
                            value="state.draft.customer ? state.draft.customer.display_name : ''"
                            resModel="'res.partner'"
                            fieldString="'Cliente'"
                            placeholder="'Todos'"
                            activeActions="activeActions"
                            getDomain.bind="getCustomerDomain"
                            update.bind="onCustomerUpdate"
                            searchLimit="10"
                        />
                    </div>
                    <div class="o_project_detail_dashboard_filter">
                        <label for="project_detail_project">Proyecto</label>
                        <Many2XAutocomplete
                            id="'project_detail_project'"
                            value="state.draft.project ? state.draft.project.display_name : ''"
                            resModel="'project.project'"
                            fieldString="'Proyecto'"
                            placeholder="'Selecciona un proyecto'"
                            activeActions="activeActions"
                            getDomain.bind="getProjectDomain"
                            update.bind="onProjectUpdate"
                            searchLimit="15"
                        />
                    </div>
                    <div class="o_project_detail_dashboard_filter">
                        <label for="project_detail_manager">Gerente</label>
                        <Many2XAutocomplete
                            id="'project_detail_manager'"
                            value="state.draft.manager ? state.draft.manager.display_name : ''"
                            resModel="'res.users'"
                            fieldString="'Gerente'"
                            placeholder="'Todos'"
                            activeActions="activeActions"
                            getDomain.bind="getManagerDomain"
                            update.bind="onManagerUpdate"
                            searchLimit="10"
                        />
                    </div>
                    <div class="o_project_detail_dashboard_filter">
                        <label for="project_detail_phase">Etapa</label>
                        <select id="project_detail_phase"
                                class="form-select"
                                t-att-disabled="!draftPhases.length"
                                t-on-change="onPhaseChange">
                            <option value="" t-att-selected="!state.draft.phaseId">Todas</option>
                            <option t-foreach="draftPhases"
                                    t-as="phase"
                                    t-key="phase.id"
                                    t-att-value="phase.id"
                                    t-att-selected="phase.id == state.draft.phaseId"
                                    t-out="phase.name"/>
                        </select>
                    </div>
                    <div class="o_project_detail_dashboard_filter">
                        <label for="project_detail_cutoff">Período de corte</label>
                        <input id="project_detail_cutoff"
                               type="month"
                               class="form-control"
                               t-att-value="state.draft.cutoff"
                               t-on-change="onCutoffChange"/>
                    </div>
                    <div class="o_project_detail_dashboard_filter_actions">
                        <button type="button"
                                class="btn btn-link o_project_detail_dashboard_clear"
                                t-att-disabled="state.loading"
                                t-on-click="clearFilters">Limpiar filtros</button>
                    </div>
                </section>

                <div t-if="state.error" class="o_project_detail_dashboard_feedback" role="alert">
                    <i class="fa fa-exclamation-circle" aria-hidden="true"/>
                    <div>
                        <strong>No se pudo cargar la información.</strong>
                        <p>Comprueba la conexión e inténtalo nuevamente.</p>
                    </div>
                    <button type="button" class="btn btn-primary" t-on-click="retryDashboard">
                        Reintentar
                    </button>
                </div>

                <div t-elif="state.loading and !state.data" class="o_project_detail_dashboard_loading" aria-live="polite">
                    <i class="fa fa-spinner fa-spin" aria-hidden="true"/>
                    <span>Cargando información del proyecto…</span>
                </div>

                <main t-elif="state.data"
                      t-attf-class="o_project_detail_dashboard_content #{state.loading ? 'o_project_detail_dashboard_content--loading' : ''}"
                      aria-live="polite">
                    <div class="o_project_detail_dashboard_kpis">
                        <button type="button"
                                class="o_project_detail_dashboard_card o_project_detail_dashboard_kpi o_project_detail_dashboard_kpi--progress"
                                t-on-click="() => this.openMetric(kpis.progress, 'Tareas del avance')">
                            <span class="o_project_detail_dashboard_kpi_icon"><i class="fa fa-bar-chart" aria-hidden="true"/></span>
                            <span class="o_project_detail_dashboard_kpi_body">
                                <span class="o_project_detail_dashboard_kpi_title">Avance global</span>
                                <strong t-if="kpis.progress.percentage !== false"><t t-out="formatPercentage(kpis.progress.percentage)"/>%</strong>
                                <strong t-else="">—</strong>
                            </span>
                            <span class="o_project_detail_dashboard_track">
                                <span class="o_project_detail_dashboard_bar o_project_detail_dashboard_bar--teal"
                                      t-att-style="getBarStyle(kpis.progress.percentage)"/>
                            </span>
                            <small t-if="kpis.progress.percentage !== false">
                                <t t-out="kpis.progress.completed"/> de <t t-out="kpis.progress.total"/> tareas completadas
                            </small>
                            <small t-else="">Sin pesos asignados a las fases</small>
                        </button>

                        <div t-attf-class="o_project_detail_dashboard_card o_project_detail_dashboard_kpi o_project_detail_dashboard_kpi--tone-#{scheduleTone}">
                            <span class="o_project_detail_dashboard_kpi_icon"><i class="fa fa-calendar" aria-hidden="true"/></span>
                            <span class="o_project_detail_dashboard_kpi_body">
                                <span class="o_project_detail_dashboard_kpi_title">Cronograma</span>
                                <strong class="o_project_detail_dashboard_kpi_text" t-out="kpis.schedule.label"/>
                            </span>
                            <small t-out="kpis.schedule.detail"/>
                        </div>

                        <button type="button"
                                class="o_project_detail_dashboard_card o_project_detail_dashboard_kpi o_project_detail_dashboard_kpi--accent o_project_detail_dashboard_kpi--tone-red"
                                t-on-click="() => this.openMetric(kpis.overdue, 'Tareas vencidas')">
                            <span class="o_project_detail_dashboard_kpi_icon"><i class="fa fa-exclamation-triangle" aria-hidden="true"/></span>
                            <span class="o_project_detail_dashboard_kpi_body">
                                <span class="o_project_detail_dashboard_kpi_title">Tareas vencidas</span>
                                <strong t-out="kpis.overdue.count"/>
                            </span>
                            <small t-if="kpis.overdue.count">Requieren seguimiento</small>
                            <small t-else="">Sin tareas vencidas</small>
                        </button>

                        <button type="button"
                                class="o_project_detail_dashboard_card o_project_detail_dashboard_kpi o_project_detail_dashboard_kpi--accent o_project_detail_dashboard_kpi--tone-indigo"
                                t-on-click="() => this.openMetric(kpis.milestones, 'Hitos')">
                            <span class="o_project_detail_dashboard_kpi_icon"><i class="fa fa-flag" aria-hidden="true"/></span>
                            <span class="o_project_detail_dashboard_kpi_body">
                                <span class="o_project_detail_dashboard_kpi_title">Hitos cumplidos</span>
                                <strong><t t-out="kpis.milestones.done"/>/<t t-out="kpis.milestones.total"/></strong>
                            </span>
                            <span class="o_project_detail_dashboard_track">
                                <span class="o_project_detail_dashboard_bar o_project_detail_dashboard_bar--indigo"
                                      t-att-style="getBarStyle(milestonePercentage)"/>
                            </span>
                            <small><t t-out="milestonePercentage"/>% de hitos completados</small>
                        </button>

                        <button type="button"
                                class="o_project_detail_dashboard_card o_project_detail_dashboard_kpi o_project_detail_dashboard_kpi--accent o_project_detail_dashboard_kpi--tone-red"
                                t-on-click="() => this.openMetric(kpis.blockers, 'Bloqueos abiertos')">
                            <span class="o_project_detail_dashboard_kpi_icon"><i class="fa fa-lock" aria-hidden="true"/></span>
                            <span class="o_project_detail_dashboard_kpi_body">
                                <span class="o_project_detail_dashboard_kpi_title">Bloqueos abiertos</span>
                                <strong t-out="kpis.blockers.count"/>
                            </span>
                            <small t-if="kpis.blockers.count">Requieren resolución</small>
                            <small t-else="">Sin tareas bloqueadas</small>
                        </button>
                    </div>

                    <div class="o_project_detail_dashboard_panels">
                        <section class="o_project_detail_dashboard_card o_project_detail_dashboard_panel">
                            <header class="o_project_detail_dashboard_panel_header">
                                <h2><i class="fa fa-tasks" aria-hidden="true"/>Avance por fase del proyecto</h2>
                                <span>% de avance</span>
                            </header>
                            <div t-if="state.data.phase_progress.length" class="o_project_detail_dashboard_bars">
                                <button t-foreach="state.data.phase_progress"
                                        t-as="phase"
                                        t-key="phase.id"
                                        type="button"
                                        t-attf-class="o_project_detail_dashboard_bar_row #{phase.selected ? 'o_project_detail_dashboard_bar_row--selected' : ''}"
                                        t-att-title="phase.completed + ' de ' + phase.total + ' tareas · peso ' + phase.weight + '%'"
                                        t-on-click="() => this.openMetric(phase)">
                                    <span class="o_project_detail_dashboard_bar_label" t-out="phase.name"/>
                                    <span class="o_project_detail_dashboard_track o_project_detail_dashboard_track--large">
                                        <span t-attf-class="o_project_detail_dashboard_bar o_project_detail_dashboard_bar--#{getPhaseTone(phase.percentage)}"
                                              t-att-style="getBarStyle(phase.percentage)"/>
                                    </span>
                                    <strong><t t-out="formatPercentage(phase.percentage)"/>%</strong>
                                </button>
                            </div>
                            <p t-else="" class="o_project_detail_dashboard_empty_text">El proyecto no tiene fases.</p>
                        </section>

                        <section class="o_project_detail_dashboard_card o_project_detail_dashboard_panel">
                            <header class="o_project_detail_dashboard_panel_header">
                                <h2><i class="fa fa-bullseye" aria-hidden="true"/>Cumplimiento de hitos</h2>
                            </header>
                            <div class="o_project_detail_dashboard_donut_body">
                                <button type="button"
                                        class="o_project_detail_dashboard_donut"
                                        t-att-style="milestoneChartStyle"
                                        t-on-click="() => this.openMetric(kpis.milestones, 'Hitos')">
                                    <span>
                                        <strong><t t-out="milestonePercentage"/>%</strong>
                                        <small>de hitos cumplidos</small>
                                    </span>
                                </button>
                                <div class="o_project_detail_dashboard_legend">
                                    <button type="button" t-on-click="() => this.openDomain(state.data.milestone_chart.done_domain, 'Hitos cumplidos')">
                                        <span class="o_project_detail_dashboard_dot o_project_detail_dashboard_dot--teal"/>
                                        <span>Hitos cumplidos</span>
                                        <strong t-out="state.data.milestone_chart.done"/>
                                    </button>
                                    <button type="button" t-on-click="() => this.openDomain(state.data.milestone_chart.pending_domain, 'Hitos pendientes')">
                                        <span class="o_project_detail_dashboard_dot o_project_detail_dashboard_dot--track"/>
                                        <span>Hitos pendientes</span>
                                        <strong t-out="state.data.milestone_chart.pending"/>
                                    </button>
                                </div>
                            </div>
                        </section>

                        <section class="o_project_detail_dashboard_card o_project_detail_dashboard_panel">
                            <header class="o_project_detail_dashboard_panel_header">
                                <h2><i class="fa fa-users" aria-hidden="true"/>Carga por responsable</h2>
                                <span>Tareas abiertas asignadas</span>
                            </header>
                            <div t-if="workload.length" class="o_project_detail_dashboard_bars o_project_detail_dashboard_bars--scroll">
                                <button t-foreach="workload"
                                        t-as="item"
                                        t-key="item.key"
                                        type="button"
                                        class="o_project_detail_dashboard_bar_row"
                                        t-on-click="() => this.openMetric(item, 'Tareas de ' + item.name)">
                                    <span class="o_project_detail_dashboard_bar_label" t-out="item.name"/>
                                    <span class="o_project_detail_dashboard_track o_project_detail_dashboard_track--large">
                                        <span t-attf-class="o_project_detail_dashboard_bar o_project_detail_dashboard_bar--#{item.color}"
                                              t-att-style="getBarStyle(item.width)"/>
                                    </span>
                                    <strong><t t-out="item.count"/> <t t-if="item.count === 1">tarea</t><t t-else="">tareas</t></strong>
                                </button>
                            </div>
                            <p t-else="" class="o_project_detail_dashboard_empty_text">No hay tareas abiertas.</p>
                        </section>
                    </div>

                    <div class="o_project_detail_dashboard_tables">
                        <section class="o_project_detail_dashboard_card o_project_detail_dashboard_panel">
                            <header class="o_project_detail_dashboard_panel_header">
                                <h2><i class="fa fa-calendar-check-o" aria-hidden="true"/>Próximos compromisos</h2>
                                <button t-if="state.data.commitments.count"
                                        type="button"
                                        class="btn btn-link o_project_detail_dashboard_see_all"
                                        t-on-click="() => this.openMetric(state.data.commitments, 'Próximos compromisos')">
                                    Ver todos (<t t-out="state.data.commitments.count"/>) <i class="fa fa-arrow-right" aria-hidden="true"/>
                                </button>
                            </header>
                            <div t-if="state.data.commitments.items.length" class="o_project_detail_dashboard_table_wrap">
                                <table class="o_project_detail_dashboard_table">
                                    <thead>
                                        <tr>
                                            <th>Tarea</th>
                                            <th>Responsable</th>
                                            <th>Fecha límite</th>
                                            <th>Estado</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr t-foreach="state.data.commitments.items"
                                            t-as="task"
                                            t-key="task.id"
                                            t-on-click="() => this.openTask(task)">
                                            <td t-out="task.name"/>
                                            <td t-out="task.responsible"/>
                                            <td class="text-nowrap" t-out="formatDate(task.deadline)"/>
                                            <td>
                                                <span t-attf-class="o_project_detail_dashboard_pill o_project_detail_dashboard_pill--#{task.status}">
                                                    <span class="o_project_detail_dashboard_dot"/>
                                                    <t t-out="task.status_label"/>
                                                </span>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                            <p t-else="" class="o_project_detail_dashboard_empty_text">No hay tareas abiertas con fecha límite.</p>
                        </section>

                        <section class="o_project_detail_dashboard_card o_project_detail_dashboard_panel">
                            <header class="o_project_detail_dashboard_panel_header">
                                <h2><i class="fa fa-exclamation-triangle o_project_detail_dashboard_icon--red" aria-hidden="true"/>Riesgos y bloqueos</h2>
                                <button t-if="state.data.risks.count"
                                        type="button"
                                        class="btn btn-link o_project_detail_dashboard_see_all"
                                        t-on-click="() => this.openMetric(state.data.risks, 'Riesgos y bloqueos')">
                                    Ver todos (<t t-out="state.data.risks.count"/>) <i class="fa fa-arrow-right" aria-hidden="true"/>
                                </button>
                            </header>
                            <div t-if="state.data.risks.items.length" class="o_project_detail_dashboard_table_wrap">
                                <table class="o_project_detail_dashboard_table">
                                    <thead>
                                        <tr>
                                            <th>Descripción</th>
                                            <th>Prioridad</th>
                                            <th>Responsable</th>
                                            <th>Próxima acción</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr t-foreach="state.data.risks.items"
                                            t-as="risk"
                                            t-key="risk.id"
                                            t-on-click="() => this.openTask(risk)">
                                            <td t-out="risk.name"/>
                                            <td>
                                                <span t-attf-class="o_project_detail_dashboard_pill o_project_detail_dashboard_pill--#{risk.priority}">
                                                    <span class="o_project_detail_dashboard_dot"/>
                                                    <t t-out="risk.priority_label"/>
                                                </span>
                                            </td>
                                            <td t-out="risk.responsible"/>
                                            <td>
                                                <span t-out="risk.next_action"/>
                                                <small t-if="risk.next_action_owner" class="d-block text-muted" t-out="risk.next_action_owner"/>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                            <p t-else="" class="o_project_detail_dashboard_empty_text">No hay tareas bloqueadas.</p>
                        </section>
                    </div>
                </main>

                <div t-elif="state.noProject" class="o_project_detail_dashboard_empty">
                    <i class="fa fa-folder-open-o" aria-hidden="true"/>
                    <h2>No hay proyectos para estos filtros</h2>
                    <p>Cambia el cliente o el gerente, o limpia los filtros.</p>
                </div>
            </div>
        </div>
    </t>
</templates>
